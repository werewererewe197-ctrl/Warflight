{
  "name": "warflight",
  "version": "1.0.0",
  "description": "Warflight — браузерная мультиплеерная 2D-игра о воздушных боях Второй мировой (вид сбоку)",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "vitest run --project unit --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test:load": "node tests/load/load.mjs",
    "selftest": "node server/selftest.js",
    "perf": "node tests/e2e/perf.mjs",
    "report:flight": "node tests/tools/flight-report.mjs",
    "report:balance": "node tests/tools/balance-report.mjs",
    "report:bots": "node tests/tools/bot-report.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vitest": "^5.1.0"
  }
}
